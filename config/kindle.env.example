# Copy to config/kindle.env, fill in your local values, and chmod 600.
# Never commit kindle.env or config/known_hosts.
KINDLE_SSH_HOST=
KINDLE_SSH_USER=
KINDLE_SSH_PORT=
KINDLE_SSH_PASSWORD=
KINDLE_SSH_DEST=

# Optional history limits (defaults shown).
KINDLE_AGENT_MAX_PAGES=15
KINDLE_AGENT_MAX_FEED_BYTES=24576

# Optional one-shot library titles generated through pi.
KINDLE_AGENT_TITLE_ENABLED=1
KINDLE_AGENT_TITLE_MODEL=openai-codex/gpt-5.6-luna
KINDLE_AGENT_TITLE_INTERVAL_LINES=500
KINDLE_AGENT_TITLE_TAIL_LINES=300
